<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/dv_bg</item>
        <item name="colorPrimaryDark">@color/dv_bg</item>
        <item name="colorAccent">@color/dv_accent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/dv_bg</item>
        <item name="android:windowBackground">@color/dv_bg</item>
        <item name="android:statusBarColor">@color/dv_bg</item>
        <item name="android:navigationBarColor">@color/dv_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/dv_accent</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/dv_bg</item>
        <item name="windowSplashScreenBackground">@color/dv_bg</item>
    </style>
</resources>
